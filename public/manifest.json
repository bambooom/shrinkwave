{
  "manifest_version": 3,
  "name": "Pixel Squoosh",
  "version": "0.1.0",
  "description": "Batch image compression that stays on your device.",
  "action": {
    "default_title": "Open Pixel Squoosh"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pixel-squoosh@example.com",
      "strict_min_version": "121.0"
    }
  }
}
