{
  "name": "shrinkwave",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "package:chrome": "npm run build && cd dist && zip -r ../shrinkwave-chrome.zip .",
    "package:firefox": "npm run build:firefox && cd dist-firefox && zip -r ../shrinkwave-firefox.zip .",
    "icons": "node scripts/icons.ts",
    "build:firefox": "tsc --noEmit && vite build --mode firefox"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
